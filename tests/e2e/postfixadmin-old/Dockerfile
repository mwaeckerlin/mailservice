# Test-only helper: seeds the schema-upgrade database with a REAL
# PostfixAdmin 3.2.4 schema by running the OLD release's own upgrade
# chain (fixture rule: an old schema is generated by the real old
# system, never hand-written). Foreign base image + shell are fine
# here — this is e2e test infrastructure, not a shipped image.
#
# php:7.4-cli matches the PHP line PostfixAdmin 3.2.x was written for
# (3.2 is not PHP 8 clean). The official image bundles the extension
# sources, so mysqli compiles locally — no EOL apk repositories.
FROM php:7.4-cli
RUN docker-php-ext-install mysqli
ADD https://github.com/postfixadmin/postfixadmin/archive/refs/tags/postfixadmin-3.2.4.tar.gz /tmp/pfa.tar.gz
RUN tar xzf /tmp/pfa.tar.gz -C /opt \
    && mv /opt/postfixadmin-postfixadmin-3.2.4 /opt/postfixadmin \
    && rm /tmp/pfa.tar.gz \
    && mkdir -p /opt/postfixadmin/templates_c \
    && chmod 777 /opt/postfixadmin/templates_c
COPY config.local.php /opt/postfixadmin/config.local.php
COPY seed-old-schema.sh /usr/local/bin/seed-old-schema.sh
RUN chmod +x /usr/local/bin/seed-old-schema.sh
ENTRYPOINT ["/usr/local/bin/seed-old-schema.sh"]
